# ==============================================================
# Cliente Supabase — se embeben en el bundle del navegador.
# ==============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ==============================================================
# Solo local, solo para scripts admin (scripts/bootstrap-me.mjs).
# NUNCA commitear ni exponer al navegador (por eso NO tiene prefijo NEXT_PUBLIC_).
# Buscar en: Supabase dashboard → Settings → API → service_role (secret).
# ==============================================================
SUPABASE_SERVICE_ROLE_KEY=
